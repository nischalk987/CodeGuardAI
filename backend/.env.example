# Backend settings. AI review is optional; the sample endpoints need no provider credentials.
APP_NAME=CodeGuard AI API
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional persistence. Set privately in backend/.env; never commit real credentials.
DATABASE_URL=

# Optional. Supply a local Groq key privately; never commit a real value.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
AI_REVIEW_MAX_INPUT_BYTES=40000
