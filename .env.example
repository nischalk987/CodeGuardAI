# Copy to .env for local development. Never commit real credentials.
# Variable names are a planned configuration contract and may evolve with implementation.

# AI reviewer — backend only
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
HF_TOKEN=
HF_MODEL=openai/gpt-oss-20b
HF_TIMEOUT_SECONDS=30
HF_MAX_RETRIES=2
AI_REVIEW_MAX_INPUT_BYTES=40000
AI_REVIEW_MAX_CONCURRENCY=4

# Application services
DATABASE_URL=postgresql+psycopg://codeguard:codeguard@localhost:5432/codeguard
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENVIRONMENT=development
LOG_LEVEL=INFO

# GitHub integration (optional; configure only when implementing the integration)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
